# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
ENV/
env/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache
.pyre/
.ipynb_checkpoints/

# SQLite runtime data
*.sqlite
*.sqlite3
data/*.sqlite
data/*.sqlite3

# Build / packaging
build/
dist/
*.egg-info/
.eggs/
site/

# Coverage / test reports
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local environment and secrets
.env
.env.*
*.pem
*.key

# Logs and temp files
*.log
tmp/
temp/
*.bak
*.orig

# Editor / IDE settings
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Generated artifacts (don't commit generated code or runtime output)
# ignore generated handler modules and deployment mapping files, but keep the directory placeholder
src/deploy/generated_handlers/*.py
src/deploy/generated_handlers/**/*.py
src/deploy/generated_handlers/*.pyc
src/deploy/agentx_mapping.json
src/deploy/agentx_mapping.*.json
src/deploy/mib_py_*/

# Generated MIB and local runtime artifacts
src/mib/resources/*.txt
src/mib/resources/*.json
src/mib/resources/**/*.txt
src/mib/resources/**/*.json

# Allow .gitkeep files in generated folders so empty folders are preserved
!important: keep .gitkeep in generated folders
!data/.gitkeep
!src/deploy/agentx_mapping.example.json
!src/deploy/generated_handlers/.gitkeep
!src/mib/resources/example/example_schema.json
!src/mib/resources/example/EXAMPLE-MIB.txt

# AgentX demo database (already covered by *.sqlite but explicit)
data/db.sqlite
